{
  "identity": "fluxdown@bilibili-bangumi",
  "name": "Bilibili视频下载",
  "version": "0.1.21",
  "description": "Bilibili 视频插件：支持番剧、UP 主投稿订阅、DASH 解析、二维码登录及登录态复用。",
  "homepage": "https://github.com/gulanthys",
  "minAppVersion": "0.1.44",
  "permissions": ["auth"],
  "auth": {
    "entry": "auth.js"
  },
  "resolvers": [
    {
      "match": {
        "urls": [
          "*://www.bilibili.com/bangumi/play/ss*",
          "*://www.bilibili.com/bangumi/play/ep*",
          "*://bilibili.com/bangumi/play/ss*",
          "*://bilibili.com/bangumi/play/ep*",
          "*://m.bilibili.com/bangumi/play/ss*",
          "*://m.bilibili.com/bangumi/play/ep*",
          "*://www.bilibili.com/bangumi/media/md*",
          "*://bilibili.com/bangumi/media/md*",
          "*://m.bilibili.com/bangumi/media/md*"
        ]
      },
      "entry": "resolve.js",
      "timeoutMs": 30000,
      "multi": true
    }
  ],
  "subscriptions": [
    {
      "providerId": "bilibili-bangumi",
      "entry": "resolve.js",
      "timeoutMs": 30000
    }
  ],
  "settings": [
    {
      "key": "cookies",
      "title": "导入 Bilibili Cookie",
      "description": "解析时使用的登录态。支持浏览器 Cookie 头或 Netscape cookies.txt；保存后插件会在后续解析中复用。",
      "type": "string",
      "widget": "textarea",
      "default": ""
    },
    {
      "key": "reuseStoredSession",
      "title": "复用已保存登录态",
      "description": "优先使用插件保存的会话；关闭后每次仅使用上方 Cookie 设置。",
      "type": "boolean",
      "widget": "toggle",
      "default": "true"
    },
    {
      "key": "includeExtras",
      "title": "包含番外与花絮",
      "description": "关闭时只列出正片并排除预告；开启后同时列出预告、PV、采访和其他分区。",
      "type": "boolean",
      "widget": "toggle",
      "default": "false"
    },
    {
      "key": "highestQualityOnly",
      "title": "优先最高画质",
      "description": "开启后每集只展示最高可用画质，避免长番剧画质条目超过宿主清单上限；关闭后展示全部可用画质。",
      "type": "boolean",
      "widget": "toggle",
      "default": "false"
    },
    {
      "key": "quality",
      "title": "默认画质",
      "description": "普通链接无人值守或选择框超时时使用的画质；番剧订阅返回全部可用画质，请用订阅过滤选择。",
      "type": "string",
      "widget": "select",
      "options": [
        { "value": "best", "label": "最佳画质" },
        { "value": "2160", "label": "不超过 2160p" },
        { "value": "1440", "label": "不超过 1440p" },
        { "value": "1080", "label": "不超过 1080p" },
        { "value": "720", "label": "不超过 720p" },
        { "value": "480", "label": "不超过 480p" },
        { "value": "audio", "label": "仅音频" }
      ],
      "default": "best"
    }
  ]
}
