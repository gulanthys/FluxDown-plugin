{
  "identity": "fluxdown@bilibili-bangumi",
  "name": "Bilibili视频下载",
  "version": "1.1.0",
  "description": "Bilibili 视频插件：支持番剧、UP 主投稿订阅、DASH 解析及二维码登录。",
  "homepage": "https://github.com/gulanthys",
  "minAppVersion": "0.6.4",
  "permissions": ["auth"],
  "auth": {
    "entry": "auth.js"
  },
  "main": {
    "entry": "main.js"
  },
  "contributes": {
    "views": [
      { "id": "login", "title": "Bilibili 扫码登录", "location": "auth" }
    ]
  },
  "resolvers": [
    {
      "match": {
        "urls": [
          "*://www.bilibili.com/bangumi/play/ss*",
          "*://www.bilibili.com/bangumi/play/ep*",
          "*://bilibili.com/bangumi/play/ss*",
          "*://bilibili.com/bangumi/play/ep*",
          "*://m.bilibili.com/bangumi/play/ss*",
          "*://m.bilibili.com/bangumi/play/ep*",
          "*://www.bilibili.com/bangumi/media/md*",
          "*://bilibili.com/bangumi/media/md*",
          "*://m.bilibili.com/bangumi/media/md*",
          "*://www.bilibili.com/bangumi/play?*season_id=*",
          "*://www.bilibili.com/bangumi/play/?*season_id=*",
          "*://bilibili.com/bangumi/play?*season_id=*",
          "*://bilibili.com/bangumi/play/?*season_id=*",
          "*://m.bilibili.com/bangumi/play?*season_id=*",
          "*://m.bilibili.com/bangumi/play/?*season_id=*",
          "*://www.bilibili.com/bangumi/media?*season_id=*",
          "*://www.bilibili.com/bangumi/media/?*season_id=*",
          "*://bilibili.com/bangumi/media?*season_id=*",
          "*://bilibili.com/bangumi/media/?*season_id=*",
          "*://m.bilibili.com/bangumi/media?*season_id=*",
          "*://m.bilibili.com/bangumi/media/?*season_id=*",
          "*://www.bilibili.com/video/BV*",
          "*://www.bilibili.com/video/av*",
          "*://bilibili.com/video/BV*",
          "*://bilibili.com/video/av*",
          "*://m.bilibili.com/video/BV*",
          "*://m.bilibili.com/video/av*",
          "*://b23.tv/*",
          "*://bili2233.cn/*"
        ]
      },
      "entry": "resolve.js",
      "timeoutMs": 30000,
      "multi": true
    }
  ],
  "subscriptions": [
    {
      "providerId": "bilibili-bangumi",
      "entry": "resolve.js",
      "timeoutMs": 30000
    }
  ],
  "settings": [
    {
      "key": "cookies",
      "title": "导入 Bilibili Cookie",
      "description": "解析时使用的登录态。支持浏览器 Cookie 头或 Netscape cookies.txt；保存后会用于后续解析与下载。",
      "type": "string",
      "widget": "textarea",
      "default": ""
    },
    {
      "key": "includeExtras",
      "title": "包含番外与花絮",
      "description": "关闭时只列出正片并排除预告；开启后同时列出预告、PV、采访和其他分区。订阅可在 providerConfig 单独覆盖。",
      "type": "boolean",
      "widget": "toggle",
      "default": "false"
    },
    {
      "key": "highestQualityOnly",
      "title": "优先最高画质",
      "description": "番剧清单每集只展示最高可用画质；订阅可通过 providerConfig 单独覆盖。",
      "type": "boolean",
      "widget": "toggle",
      "default": "false"
    },
    {
      "key": "quality",
      "title": "默认画质",
      "description": "普通链接的默认画质；订阅可通过 providerConfig 单独设置画质上限。没有满足上限的画质时会明确报错。",
      "type": "string",
      "widget": "select",
      "options": [
        { "value": "best", "label": "最佳画质" },
        { "value": "2160", "label": "不超过 2160p" },
        { "value": "1440", "label": "不超过 1440p" },
        { "value": "1080", "label": "不超过 1080p" },
        { "value": "720", "label": "不超过 720p" },
        { "value": "480", "label": "不超过 480p" },
        { "value": "audio", "label": "仅音频" }
      ],
      "default": "best"
    }
  ]
}
